#!/bin/bash

# 1. Проверяем, есть ли файл со специальным README
if [ ! -f "./README_GV.md" ]; then
    echo "Ошибка: Создай файл README_GV.md (это будет README для GitVerse)"
    exit 1
fi

echo "--- Начинаю синхронизацию с GitVerse ---"

# 2. Временно подменяем README
cp README.md README_TEMP_BAK
cp README_RU.md README.md

# 3. Добавляем изменения и делаем временный коммит
git add README.md
git commit -m "temp: update readme for gitverse"

# 4. Пушим в основную ветку GitVerse
# (замени master на main, если на GitVerse главная ветка называется main)
git push gitverse HEAD:master --force
git push moshub HEAD:master --force

# 5. Откатываем коммит назад, чтобы README в истории не мусорил
git reset --hard HEAD~1

# 6. Возвращаем оригинальный README на место
mv README_TEMP_BAK README.md

echo "--- Готово! GitVerse обновлен, локально и на GitHub всё по-прежнему. ---"

